{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault",
  "version": "1.0.0",
  "identifier": "com.vault.app",
  "build": {
    "frontendDist": "../../frontend",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vault",
        "width": 430,
        "height": 900,
        "minWidth": 375,
        "minHeight": 700,
        "maxWidth": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Vault"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Personal finance tracker",
    "longDescription": "Vault is a beautiful personal finance companion. Track spending, set goals, manage subscriptions, and visualise your financial health — all in one place.",
    "copyright": "Ahmad Faizi",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
